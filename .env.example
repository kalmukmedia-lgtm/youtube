# Bu dosyayı .env olarak kopyala ve doldur:  cp .env.example .env
# .env asla repoya eklenmez.

# Senaryo üretimi (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# İsteğe bağlı: senaryo modeli (varsayılan: claude-opus-5-5)
# METAFICTA_MODEL=claude-opus-5-5

# İsteğe bağlı: Remotion kendi Chrome'unu indiremiyorsa kullanılacak tarayıcı yolu
# REMOTION_BROWSER_EXECUTABLE=

# Seslendirme (Azure Speech, Free F0) — kurulum: docs/VOICE_SETUP.md
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Görsel üretimi (Cloudflare Workers AI, ücretsiz kota) — kurulum: docs/IMAGE_SETUP.md
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sonraki fazlar (henüz kullanılmıyor)
# YOUTUBE_CLIENT_SECRET_PATH=secrets/client_secret.json   # Faz 8: yükleme
